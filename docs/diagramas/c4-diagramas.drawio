        <mxCell id="d1_sys" value="&lt;b&gt;Sistema de Gestión de Emergencias&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Recibe, prioriza, asigna y notifica solicitudes de emergencia en Chocó, Pereira, Cali y Manizales. 4 microservicios serverless.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1061B0;fontColor=#ffffff;strokeColor=none;arcSize=6;align=center;" vertex="1" parent="1">
